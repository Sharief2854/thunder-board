{
  "name": "thunderboard",
  "version": "1.0.0",
  "description": "ThunderBoard",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "electron .",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "tsc && vite build && electron-builder",
    "generate:icons": "node scripts/generate-icons.js"
  },
  "build": {
    "appId": "com.thunderboard.app",
    "productName": "ThunderBoard",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "thunderboard",
    "whiteboard",
    "digital-board",
    "teaching",
    "programming",
    "syntax-highlighter",
    "offline-first",
    "electron",
    "react",
    "typescript"
  ],
  "author": "ThunderBoard Team",
  "license": "MIT",
  "dependencies": {
    "@types/prismjs": "^1.26.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "perfect-freehand": "^1.2.2",
    "prismjs": "^1.30.0",
    "rbush": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/rbush": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
